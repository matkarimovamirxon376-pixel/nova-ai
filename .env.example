# NOVA AI — environment configuration.
# Copy this file to ".env" and fill in values. The .env file is git-ignored.
# These values stay on the SERVER and are never sent to the browser.

# Server
HOST=0.0.0.0
PORT=3000

# AI provider: none | ollama | groq | gemini | openai
# "none" (default) runs the app without any AI and is honest about it.
# FREE options that need NO payment: ollama (local), groq, gemini.
AI_PROVIDER=none

# --- Groq (FREE tier, no credit card, OpenAI-compatible, very fast) ---
# Get a key at https://console.groq.com  (API Keys -> Create API Key).
# Then set AI_PROVIDER=groq and uncomment:
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_VISION_MODEL=    # only if you pick a Groq model that supports images

# --- Ollama (FREE, fully local, no API key, no account, private) ---
# Install from https://ollama.com, run `ollama pull llama3.1`, then:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_VISION_MODEL=llava   # pull with: ollama pull llava  (for image analysis)

# --- Google Gemini (FREE tier, no credit card) ---
# Get a key at https://aistudio.google.com/app/apikey. Then AI_PROVIDER=gemini:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_VISION_MODEL=gemini-1.5-flash   # 1.5 flash/pro are multimodal
# NOTE: on Gemini's free tier your prompts/responses may be used to improve
# Google products — avoid confidential data, or use a paid tier / Ollama.

# --- OpenAI (PAID) or any OpenAI-compatible endpoint ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# Max upload size in bytes (default 8 MB)
# MAX_UPLOAD_BYTES=8388608
